# WanderGraph Backend Configuration Example
# Copy to .env and insert your real keys. NEVER commit your actual .env file to GitHub!

# Google Places API (New) Key (from Google Cloud Console)
GOOGLE_MAPS_API_KEY=

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
