# WanderGraph Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit actual API keys to source control!

# Google Places API (New) Key
# Obtain from Google Cloud Console with Places API (New) enabled:
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_MAPS_API_KEY=

# Optional Gemini API Key for enhanced conversational understanding
# If left empty, WanderGraph uses its built-in deterministic NLP regex parser
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
